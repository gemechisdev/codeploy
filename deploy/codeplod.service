[Unit]
Description=codeplo control plane
After=network-online.target
Wants=network-online.target

[Service]
User=codeplo
Group=codeplo
Environment=CODEPLO_DATA_DIR=/var/lib/codeplo
Environment=CODEPLO_LISTEN=127.0.0.1:7443
# Operator-tunable settings (for example CODEPLO_ACME_EMAIL, the certificate contact address) live here; the
# leading - keeps the service starting on hosts that have no env file yet.
EnvironmentFile=-/etc/default/codeplod
ExecStart=/usr/local/bin/codeplod
Restart=on-failure
RestartSec=3
StateDirectory=codeplo
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/codeplo
# Container access (the docker group, added as a drop-in by install.sh) and the host shell (the
# socket-activated helper, ADR 0006) stay outside these privileges on purpose: the daemon is unprivileged
# and asks for both over a socket. Widen anything here only with a written reason.

[Install]
WantedBy=multi-user.target
