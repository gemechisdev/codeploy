[Unit]
Description=codeplo host-shell helper socket

[Socket]
# Only the codeplo service user may connect. The helper re-checks the peer uid with SO_PEERCRED.
# RuntimeDirectory ensures /run/codeplo-pty is created with the correct group (codeplo) on every boot
# and cleaned up when the socket unit is stopped, avoiding root:root directories that block the panel.
RuntimeDirectory=codeplo-pty
RuntimeDirectoryMode=0750
ListenStream=/run/codeplo-pty/pty.sock
SocketUser=root
SocketGroup=codeplo
SocketMode=0660
Accept=yes

[Install]
WantedBy=sockets.target
